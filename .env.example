# ── HeatWatch environment ──────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/heatwatch

# Secret used to sign auth tokens (required — use a long random string)
JWT_SECRET=

# HTTP port (optional, default 3000)
PORT=3000

# IMD adapter. Leave IMD_API_BASE empty if you do not have access to an
# IMD endpoint — the adapter will then report imd_status = "unavailable"
# instead of fabricating data.
IMD_API_BASE=
IMD_API_KEY=

# Nominatim usage policy requires a valid identifying User-Agent/contact.
NOMINATIM_USER_AGENT=HeatWatch-SIH-Prototype/1.0 (contact: set-me@example.com)
