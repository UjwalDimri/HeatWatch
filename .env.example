# ── HeatWatch environment ──────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/heatwatch

# Secret used to sign auth tokens (required — use a long random string)
JWT_SECRET=

# HTTP port (optional, default 3000)
PORT=3000

# Open-Meteo configuration (optional).
# On shared cloud hosting like Render, free shared IPs often hit HTTP 429 rate limits.
# You can provide an Open-Meteo API key to bypass IP limits.
OPEN_METEO_API_KEY=
OPEN_METEO_API_BASE=

# IMD adapter. Set to https://mausam.imd.gov.in/api/current_wx_api.php for public IMD
# observatory data, or leave empty if not used.
IMD_API_BASE=
IMD_API_KEY=

# When deployed on shared cloud hosts (like Render) and Open-Meteo returns HTTP 429,
# setting DEMO_FALLBACK=true (default) activates a clearly-labelled synthetic demo weather
# fallback so prototype evaluation and dashboard assessment never crash. Set to 'false' to disable.
DEMO_FALLBACK=true

# Nominatim usage policy requires a valid identifying User-Agent/contact.
NOMINATIM_USER_AGENT=HeatWatch-SIH-Prototype/1.0 
