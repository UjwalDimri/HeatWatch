<%- include('partials/header', { title: 'Observatory Portal Access', bodyClass: 'auth', extraCss: ['/css/auth.css'] }) %>
<%- include('partials/navbar') %>

<main class="auth-main">
  <div class="auth-box card-3d">
    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.6rem;">
      <div class="brand-icon" style="width:34px;height:34px;">
        <i data-lucide="lock" style="width:18px;height:18px;color:#041226;"></i>
      </div>
      <h1 style="margin:0;">Portal Access</h1>
    </div>
    
    <p class="auth-sub">
      Unified credential gateway for citizens, municipal officials, and system operators.
    </p>

    <!-- Quick Demo Role Switcher -->
    <div style="background:rgba(255,255,255,0.03);border:1px solid var(--rule);border-radius:var(--radius-sm);padding:0.75rem;margin-bottom:1.2rem;">
      <span style="font-size:0.78rem;text-transform:uppercase;letter-spacing:0.04em;color:var(--shade);display:block;margin-bottom:0.4rem;font-weight:700;">
        <i data-lucide="key-round" style="width:12px;height:12px;vertical-align:-2px;margin-right:3px;"></i>Quick Demo Autofill
      </span>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.4rem;">
        <button type="button" class="btn btn-quiet" id="btn-demo-admin" style="font-size:0.78rem;padding:0.35rem 0.2rem;border:1px solid var(--panel-border);">
          Admin
        </button>
        <button type="button" class="btn btn-quiet" id="btn-demo-gov" style="font-size:0.78rem;padding:0.35rem 0.2rem;border:1px solid var(--panel-border);">
          Government
        </button>
        <button type="button" class="btn btn-quiet" id="btn-demo-citizen" style="font-size:0.78rem;padding:0.35rem 0.2rem;border:1px solid var(--panel-border);">
          Citizen
        </button>
      </div>
    </div>

    <form id="login-form" novalidate>
      <label>
        <span><i data-lucide="mail" style="width:13px;height:13px;vertical-align:-2px;margin-right:4px;"></i>Email Address</span>
        <input type="email" name="email" id="login-email" required autocomplete="email" placeholder="name@domain.com">
      </label>

      <label>
        <span><i data-lucide="key" style="width:13px;height:13px;vertical-align:-2px;margin-right:4px;"></i>Access Password</span>
        <input type="password" name="password" id="login-password" required autocomplete="current-password" placeholder="••••••••">
      </label>

      <p class="form-error banner" id="login-error" role="alert" hidden></p>

      <button class="btn btn-primary btn-wide" type="submit" style="margin-top:1.2rem;">
        <i data-lucide="log-in" style="width:16px;height:16px;"></i>Authenticate &amp; Enter
      </button>
    </form>

    <p class="auth-alt">
      New citizen? <a href="/signup">Create your thermal profile</a>.
    </p>
  </div>
</main>

<script>
const form = document.getElementById('login-form');
const emailInput = document.getElementById('login-email');
const passInput = document.getElementById('login-password');

document.getElementById('btn-demo-admin')?.addEventListener('click', () => {
  emailInput.value = 'admin@heatwatch.demo';
  passInput.value = 'heatwatch-demo';
});

document.getElementById('btn-demo-gov')?.addEventListener('click', () => {
  emailInput.value = 'government@heatwatch.demo';
  passInput.value = 'heatwatch-demo';
});

document.getElementById('btn-demo-citizen')?.addEventListener('click', () => {
  emailInput.value = 'citizen@heatwatch.demo';
  passInput.value = 'heatwatch-demo';
});

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const errEl = document.getElementById('login-error');
  errEl.hidden = true;
  try {
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: emailInput.value, password: passInput.value }),
    });
    const body = await res.json();
    if (res.ok) {
      window.location.href = body.redirect;
    } else {
      errEl.textContent = body.error || 'Authentication failed.';
      errEl.hidden = false;
    }
  } catch (err) {
    errEl.textContent = 'Server unreachable. Please try again.';
    errEl.hidden = false;
  }
});

window.addEventListener('DOMContentLoaded', () => {
  if (window.HW_3DCARD && window.HW_3DCARD.init) {
    window.HW_3DCARD.init();
  }
});
</script>

<%- include('partials/footer') %>
