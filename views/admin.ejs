<%- include('partials/header', { title: 'System', bodyClass: 'admin', extraCss: ['/css/admin.css'] }) %>
<%- include('partials/navbar') %>
<main class="admin-main">
  <h1>System administration</h1>
  <p class="banner banner-error" id="admin-error" hidden></p>

  <section class="panel">
    <h2>System statistics</h2>
    <dl class="stat-row" id="admin-stats">
      <div><dt>Total users</dt><dd id="a-users">—</dd></div>
      <div><dt>Active users (24 h)</dt><dd id="a-active">—</dd></div>
      <div><dt>Predictions</dt><dd id="a-preds">—</dd></div>
      <div><dt>Alerts</dt><dd id="a-alerts">—</dd></div>
      <div><dt>User profiles</dt><dd id="a-uprofiles">—</dd></div>
      <div><dt>Synthetic profiles</dt><dd id="a-sprofiles">—</dd></div>
    </dl>
  </section>

  <section class="panel">
    <h2>API status <span class="h-note">(live probes — never hard-coded)</span></h2>
    <table class="admin-table" id="api-status-table">
      <thead><tr><th>Source</th><th>State</th><th>Checked</th><th>Detail</th></tr></thead>
      <tbody><tr><td colspan="4">Probing…</td></tr></tbody>
    </table>
  </section>

  <section class="panel">
    <h2>Data status</h2>
    <table class="admin-table" id="data-status-table">
      <thead><tr><th>Dataset</th><th>Present</th><th>Size</th><th>Modified</th></tr></thead>
      <tbody></tbody>
    </table>
  </section>

  <section class="panel">
    <h2>HTSI model</h2>
    <dl class="ledger" id="model-info">
      <div><dt>Status</dt><dd id="m-status">—</dd></div>
      <div><dt>Type</dt><dd id="m-type">—</dd></div>
      <div><dt>Version</dt><dd id="m-version">—</dd></div>
      <div><dt>Trained</dt><dd id="m-date">—</dd></div>
      <div><dt>Label source</dt><dd id="m-labels">—</dd></div>
      <div><dt>Test metrics</dt><dd id="m-metrics">—</dd></div>
    </dl>
  </section>

  <section class="panel">
    <h2>Users</h2>
    <table class="admin-table" id="users-table">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Created</th><th>Last login</th></tr></thead>
      <tbody></tbody>
    </table>
  </section>

  <section class="panel">
    <h2>Logs</h2>
    <table class="admin-table" id="logs-table">
      <thead><tr><th>Time</th><th>Level</th><th>Category</th><th>Message</th></tr></thead>
      <tbody></tbody>
    </table>
  </section>
</main>
<script src="/js/admin.js"></script>
<%- include('partials/footer') %>
