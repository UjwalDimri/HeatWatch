<%- include('partials/header', { title: 'Create Citizen Profile', bodyClass: 'auth', extraCss: ['/css/auth.css'] }) %>
<%- include('partials/navbar') %>

<main class="auth-main">
  <div class="auth-box auth-box-wide card-3d">
    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.6rem;">
      <div class="brand-icon" style="width:34px;height:34px;">
        <i data-lucide="user-plus" style="width:18px;height:18px;color:#041226;"></i>
      </div>
      <h1 style="margin:0;">Citizen Profile Calibration</h1>
    </div>

    <p class="auth-sub">
      Your profile calibrates the personalized <strong>HTSI</strong> biometeorological score. The ambient 
      physical UTCI remains identical for all occupants at your location. Data is processed locally for prototype simulation.
    </p>

    <form id="signup-form" novalidate>
      <fieldset>
        <legend><i data-lucide="user" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px;"></i>Personal Credentials</legend>
        <label>Full Name <input name="name" required minlength="2" placeholder="e.g. Priya Sharma"></label>
        <label>Email Address <input type="email" name="email" required autocomplete="email" placeholder="priya@example.com"></label>
        <label>Password (min 8 characters) <input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="••••••••"></label>
        <label>Age (years) <input type="number" name="age" min="0" max="120" value="28" required></label>
      </fieldset>

      <fieldset>
        <legend><i data-lucide="briefcase" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px;"></i>Occupation Profile</legend>
        <label>Job Title / Description <input name="occupation" placeholder="e.g. Agronomist, Delivery Partner, Engineer"></label>
        <label>Occupation Category
          <select name="occupationCategory">
            <option value="outdoor_labour">Outdoor labour (Agriculture, Construction)</option>
            <option value="outdoor_service">Outdoor service (Delivery, Traffic, Street)</option>
            <option value="indoor_industrial">Indoor industrial (Manufacturing, Foundry)</option>
            <option value="indoor_service">Indoor service (Retail, Hospitality)</option>
            <option value="indoor_office" selected>Indoor office (Desk / Climate controlled)</option>
            <option value="domestic">Domestic / Student / Retired</option>
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend><i data-lucide="heart-pulse" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px;"></i>Health &amp; Physiological Vulnerability</legend>
        <label>General Health-Risk Category
          <select name="healthRiskCategory">
            <option value="low" selected>Low Vulnerability</option>
            <option value="moderate">Moderate</option>
            <option value="high">High Vulnerability</option>
            <option value="very_high">Very High Vulnerability</option>
          </select>
        </label>
        <label>Pre-existing Health Condition
          <select name="healthCondition">
            <option value="none" selected>None / Healthy</option>
            <option value="asthma">Asthma / Respiratory</option>
            <option value="hypertension">Hypertension</option>
            <option value="diabetes">Diabetes</option>
            <option value="heart_disease">Cardiovascular condition</option>
            <option value="kidney_disease">Renal / Kidney disease</option>
            <option value="copd">COPD</option>
          </select>
        </label>
        <label>Multiple Chronic Conditions?
          <select name="multipleHealthConditions">
            <option value="no" selected>No</option>
            <option value="yes">Yes (Higher susceptibility)</option>
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend><i data-lucide="sun" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px;"></i>Environmental Exposure</legend>
        <label>Outdoor Exposure (hours/day) <input type="number" name="outdoorExposureHours" min="0" max="16" step="0.5" value="2"></label>
        <label>Exposure Tier
          <select name="exposureCategory">
            <option value="low" selected>Low (&lt;2 hours)</option>
            <option value="moderate">Moderate (2–4 hours)</option>
            <option value="high">High (4–7 hours)</option>
            <option value="very_high">Very high (&gt;7 hours)</option>
          </select>
        </label>
        <label>Physical Exertion / Workload
          <select name="activityLevel">
            <option value="light" selected>Light (Sedentary / Gentle walking)</option>
            <option value="moderate">Moderate (Sustained motion)</option>
            <option value="heavy">Heavy (Physical lifting / Strenuous)</option>
            <option value="very_heavy">Very heavy (Extreme physical toil)</option>
          </select>
        </label>
        <label>Direct Heat Exposure
          <select name="occupationalHeatExposure">
            <option value="low" selected>Low / Ambient</option>
            <option value="moderate">Moderate</option>
            <option value="high">High (Direct radiant ovens/sun)</option>
          </select>
        </label>
        <label>Heat Acclimatization Status
          <select name="heatAcclimatization">
            <option value="low">Low (Newly arrived / unadapted)</option>
            <option value="moderate" selected>Moderate</option>
            <option value="high">High (Long-term resident)</option>
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend><i data-lucide="shield" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px;"></i>Mitigation &amp; Protection Access</legend>
        <label>Active Cooling Access (AC/Fans) <select name="coolingAccess"><option value="yes" selected>Full access</option><option value="partial">Partial</option><option value="no">No cooling</option></select></label>
        <label>Drinking Hydration Access <select name="hydrationAccess"><option value="yes" selected>Abundant cold water</option><option value="partial">Limited</option><option value="no">Severely limited</option></select></label>
        <label>Protective Clothing Available <select name="protectiveClothing"><option value="yes">Optimal light/ventilated</option><option value="partial" selected>Standard</option><option value="no">Heavy / Unsuited</option></select></label>
        <label>Shade Availability <select name="shadeAccess"><option value="yes" selected>Continuous shade</option><option value="partial">Intermittent</option><option value="no">Zero shade</option></select></label>
        <label>Cool-down Break Frequency <select name="breakFrequency"><option value="frequent" selected>Frequent rests</option><option value="occasional">Occasional</option><option value="rare">Rare / Nonexistent</option></select></label>
      </fieldset>

      <fieldset>
        <legend><i data-lucide="map-pin" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px;"></i>Coordinates &amp; Location Anchor</legend>
        <p class="field-help">Resolve coordinates via hardware GPS, search location names, or input manually.</p>
        <div class="loc-row">
          <button type="button" class="btn" id="use-gps">
            <i data-lucide="crosshair" style="width:14px;height:14px;"></i>Use GPS
          </button>
          <input id="loc-search" placeholder="Search city or landmark (e.g. Agra, Aligarh, Delhi)">
          <button type="button" class="btn" id="loc-search-btn">
            <i data-lucide="search" style="width:14px;height:14px;"></i>Search
          </button>
        </div>
        <ul id="loc-results" class="loc-results" style="grid-column: 1 / -1;"></ul>
        <div class="loc-row">
          <label>Latitude <input type="number" name="latitude" step="any" required placeholder="28.6139"></label>
          <label>Longitude <input type="number" name="longitude" step="any" required placeholder="77.2090"></label>
        </div>
        <label>City / Municipal Region <input name="city" placeholder="e.g. New Delhi"></label>
        <label>State / Territory <input name="state" placeholder="e.g. Delhi"></label>
      </fieldset>

      <p class="form-error banner" id="signup-error" role="alert" hidden></p>
      
      <button class="btn btn-primary btn-wide" type="submit" style="margin-top:1.5rem;padding:0.8rem;">
        <i data-lucide="check-circle" style="width:18px;height:18px;"></i>Register Profile &amp; Launch Observatory
      </button>
    </form>
    
    <p class="auth-alt">
      Already registered? <a href="/login">Authenticate with existing credentials</a>.
    </p>
  </div>
</main>

<script>
const form = document.getElementById('signup-form');
const errEl = document.getElementById('signup-error');

document.getElementById('use-gps').addEventListener('click', () => {
  if (!navigator.geolocation) {
    errEl.textContent = 'Geolocation is not supported by your browser.';
    errEl.hidden = false;
    return;
  }
  navigator.geolocation.getCurrentPosition(
    (pos) => {
      form.latitude.value = pos.coords.latitude.toFixed(4);
      form.longitude.value = pos.coords.longitude.toFixed(4);
    },
    () => {
      errEl.textContent = 'Could not acquire GPS signal. Search city or type coordinates.';
      errEl.hidden = false;
    }
  );
});

document.getElementById('loc-search-btn').addEventListener('click', async () => {
  const q = document.getElementById('loc-search').value;
  const list = document.getElementById('loc-results');
  list.innerHTML = '<li>Searching…</li>';
  try {
    const res = await fetch('/api/location/search?q=' + encodeURIComponent(q));
    const body = await res.json();
    list.innerHTML = '';
    if (!res.ok) {
      list.innerHTML = '<li>' + (body.error || 'Search failed.') + '</li>';
      return;
    }
    if (!body.results.length) {
      list.innerHTML = '<li>No geographic matches found.</li>';
      return;
    }
    body.results.forEach((r) => {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = r.displayName;
      btn.addEventListener('click', () => {
        form.latitude.value = r.latitude.toFixed(4);
        form.longitude.value = r.longitude.toFixed(4);
        if (r.displayName) {
          const parts = r.displayName.split(',');
          if (parts.length > 0 && !form.city.value) form.city.value = parts[0].trim();
        }
        list.innerHTML = '';
      });
      li.appendChild(btn);
      list.appendChild(li);
    });
  } catch (e) {
    list.innerHTML = '<li>Network error during location resolution.</li>';
  }
});

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  errEl.hidden = true;
  const data = Object.fromEntries(new FormData(form).entries());
  try {
    const res = await fetch('/api/auth/signup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const body = await res.json();
    if (res.ok) {
      window.location.href = body.redirect;
    } else {
      errEl.textContent = body.error || 'Registration failed.';
      errEl.hidden = false;
    }
  } catch (err) {
    errEl.textContent = 'Server communication failed. Please check connection.';
    errEl.hidden = false;
  }
});

window.addEventListener('DOMContentLoaded', () => {
  if (window.HW_3DCARD && window.HW_3DCARD.init) {
    window.HW_3DCARD.init();
  }
});
</script>

<%- include('partials/footer') %>
