<%- include('partials/header', { title: 'Regional map', bodyClass: 'gov', extraCss: ['https://unpkg.com/leaflet@1.9.4/dist/leaflet.css', '/css/government.css'] }) %>
<%- include('partials/navbar') %>
<main class="gov-main">
  <aside class="gov-rail">
    <h1>Regional heat risk</h1>
    <p class="gov-sub">Latest stored assessments per monitored point, last 48 h.</p>
    <dl class="gov-stats">
      <div><dt>Monitored locations</dt><dd id="g-total">—</dd></div>
      <div><dt>High risk</dt><dd id="g-high">—</dd></div>
      <div><dt>Very high risk</dt><dd id="g-vhigh">—</dd></div>
      <div><dt>Extreme risk</dt><dd id="g-extreme">—</dd></div>
      <div><dt>UTCI range</dt><dd id="g-utci">—</dd></div>
    </dl>
    <div class="chart-block"><canvas id="chart-dist" height="180"></canvas></div>
    <div class="legend">
      <h2>Application risk level (HTSI)</h2>
      <ul id="legend-list"></ul>
      <p class="data-note">These are HeatWatch application categories derived from HTSI — kept separate from the
         official UTCI stress scale shown per point.</p>
    </div>
    <p class="banner banner-error" id="gov-error" hidden></p>
    <p class="data-note">Hotspots are computed by HeatWatch (weather → Tmrt + vapour pressure → UTCI → profile →
       HTSI). OpenStreetMap is the base map only; Leaflet only visualizes.</p>
  </aside>
  <div id="map" role="application" aria-label="Heat risk map"></div>
</main>
<script>
  window.HEATWATCH_RISK_COLORS = <%- JSON.stringify(riskColors) %>;
</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="/js/map.js"></script>
<script src="/js/government.js"></script>
<%- include('partials/footer') %>
