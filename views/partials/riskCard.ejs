<section class="panel panel-risk card-3d" id="risk-panel" aria-live="polite">
  <h2>
    <i data-lucide="shield-alert" style="width:18px;height:18px;color:var(--shade);"></i>
    Personalized Thermal Risk
  </h2>

  <!-- 3D Holographic Scanner & Score Readout -->
  <div class="risk-cockpit-layout">
    <div id="holo-gauge-container" title="3D Volumetric Thermal Gauge"></div>
    
    <div class="risk-readout">
      <div class="risk-score">
        <span class="risk-number" id="r-htsi">—</span>
        <span class="risk-unit">HTSI</span>
      </div>
      <div class="risk-level-wrap">
        <span class="risk-level" id="r-level">awaiting data</span>
        <span class="risk-method" id="r-method"></span>
      </div>
    </div>
  </div>

  <!-- Dynamic Glowing Scale Bar -->
  <div class="scale-strip" aria-hidden="true">
    <div class="scale-track">
      <div class="scale-marker" id="r-marker"></div>
    </div>
    <div class="scale-labels">
      <span>Low</span>
      <span>Moderate</span>
      <span>High</span>
      <span>Very high</span>
      <span>Extreme</span>
    </div>
  </div>

  <details class="risk-why" id="r-why-wrap">
    <summary>
      <i data-lucide="help-circle" style="width:15px;height:15px;"></i>
      Why this level? Factor breakdown
    </summary>
    <p class="explain">
      UTCI represents physical ambient thermal stress — identical for everyone at your coordinates. 
      HTSI personalizes that value by fusing your reported work exertion, outdoor exposure hours, and physiological vulnerability.
    </p>
    <ul id="r-factors" class="factor-list"></ul>
    <p class="disclaimer">Estimated personalized heat risk from a prototype assessment — not a certified medical diagnosis.</p>
  </details>
</section>
