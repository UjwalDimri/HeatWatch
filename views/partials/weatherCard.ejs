<section class="panel" id="weather-panel" aria-live="polite">
  <h2>Current conditions</h2>
  <dl class="ledger">
    <div><dt>Air temperature</dt><dd id="w-temp">—</dd></div>
    <div><dt>Relative humidity</dt><dd id="w-rh">—</dd></div>
    <div><dt>Wind (10 m)</dt><dd id="w-wind">—</dd></div>
    <div><dt>Solar radiation</dt><dd id="w-rad">—</dd></div>
  </dl>
  <h2>Thermal environment</h2>
  <dl class="ledger">
    <div><dt>Vapour pressure</dt><dd id="w-vp">—</dd></div>
    <div><dt>Mean radiant temperature (Tmrt)</dt><dd id="w-tmrt">—</dd></div>
    <div><dt>UTCI</dt><dd id="w-utci">—</dd></div>
    <div><dt>UTCI stress category</dt><dd id="w-utci-cat">—</dd></div>
  </dl>
  <p class="data-meta">
    Source <strong id="w-source">—</strong> · updated <span id="w-updated">—</span> ·
    data <span id="w-status" class="status-chip">—</span> ·
    Tmrt <span id="w-tmrt-status" class="status-chip">—</span> ·
    UTCI <span id="w-utci-status" class="status-chip">—</span>
  </p>
  <p class="data-note" id="w-notes" hidden></p>
</section>
