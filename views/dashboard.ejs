<%- include('partials/header', { title: 'My risk', bodyClass: 'dashboard', extraCss: ['/css/dashboard.css'] }) %>
<%- include('partials/navbar') %>
<main class="dash-main">
  <header class="dash-head">
    <div>
      <h1>Hello, <%= user.name %></h1>
      <p class="dash-sub" id="location-line">Location: <span id="loc-label">not set</span></p>
      <p class="dash-sub profile-line">
        Profile: <%= profile ? [profile.occupation || 'occupation not set', (profile.exposureCategory || '?') + ' exposure', (profile.activityLevel || '?') + ' activity'].join(' · ') : 'no profile on record' %>
      </p>
    </div>
    <div class="dash-controls">
      <button class="btn" id="use-gps">Use my GPS</button>
      <input id="loc-search" placeholder="Search a place">
      <button class="btn" id="loc-search-btn">Search</button>
      <button class="btn btn-primary" id="refresh-btn">Refresh assessment</button>
    </div>
    <ul id="loc-results" class="loc-results"></ul>
  </header>

  <p class="banner banner-error" id="dash-error" role="alert" hidden></p>

  <div class="dash-grid">
    <%- include('partials/weatherCard') %>
    <%- include('partials/riskCard') %>
    <%- include('partials/alertCard') %>
    <section class="panel panel-charts">
      <h2>Recent history</h2>
      <div class="chart-block"><canvas id="chart-temp" height="140"></canvas></div>
      <div class="chart-block"><canvas id="chart-utci" height="140"></canvas></div>
      <div class="chart-block"><canvas id="chart-htsi" height="140"></canvas></div>
      <p class="data-note">Temperature and UTCI history come from the live source series and your stored
         assessments; HTSI history is your own stored assessments. Nothing is back-filled or invented.</p>
    </section>
  </div>
</main>
<script>
  window.HEATWATCH_PROFILE_LOCATION = <%- JSON.stringify(profile && profile.latitude != null && profile.longitude != null ? { latitude: profile.latitude, longitude: profile.longitude, city: profile.city || '' } : null) %>;
  window.HEATWATCH_RISK_COLORS = <%- JSON.stringify(riskColors) %>;
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="/js/charts.js"></script>
<script src="/js/dashboard.js"></script>
<%- include('partials/footer') %>
